<?xml version="1.0"?>
<ruleset name="storyblok-transfer-generator">
    <description>PSR-12 with a wider line limit.</description>

    <file>src</file>
    <file>tests</file>
    <file>bin/generate</file>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="140"/>
        </properties>
    </rule>
</ruleset>
