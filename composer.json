{
    "name": "tuxonice/storyblok-transfers",
    "description": "Generate PHP transfer objects from your Storyblok components, and read stories from the Content Delivery API straight into them",
    "type": "library",
    "license": "MIT",
    "keywords": ["storyblok", "cms", "headless", "content-delivery-api", "dto", "transfer-objects", "codegen"],
    "homepage": "https://github.com/tuxonice/storyblok-transfers",
    "authors": [
        {
            "name": "Helder Correia",
            "email": "tuxboy@tlab.pt",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/tuxonice/storyblok-transfers/issues",
        "source": "https://github.com/tuxonice/storyblok-transfers",
        "docs": "https://github.com/tuxonice/storyblok-transfers/tree/main/documentation",
        "security": "https://github.com/tuxonice/storyblok-transfers/security/policy"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "tuxonice/transfer-objects": "^1.2",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.13.6 || ^4.0.0",
        "symfony/var-dumper": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "Tlab\\StoryblokTransfers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tlab\\StoryblokTransfers\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/generate"],
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
