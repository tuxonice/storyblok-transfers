# Copy to .env and fill in the blanks:
#
#     cp .env.example .env
#
# .env is git-ignored - never commit real credentials.
#
# Docker Compose reads .env automatically, so `make` targets and
# `docker compose run` pick these up. Variables already exported in your shell
# take precedence over the values here.
#
# Note that the package itself ships no dotenv reader: bin/generate calls
# getenv(), and it is Compose that injects these into the container. To run the
# CLI outside Docker, export them yourself:
#
#     set -a && . ./.env && set +a


# ---------------------------------------------------------------------------
# Storyblok
# ---------------------------------------------------------------------------

# Space ID - Storyblok > Settings > General, or the number in the space URL.
STORYBLOK_SPACE_ID=

# Personal access token - Storyblok > My Account > Personal access tokens.
# Needs read access to the space. This is a Management API token, NOT the
# preview/public Content Delivery API token.
#
# The Management API takes this token bare in the Authorization header, which is
# the default and is verified working. Set STORYBLOK_AUTH_SCHEME=Bearer below
# only if you use a token issued through the OAuth flow.
STORYBLOK_MANAGEMENT_TOKEN=


# ---------------------------------------------------------------------------
# Output (optional - these are the defaults)
# ---------------------------------------------------------------------------

# Supplying these as variables rather than CLI arguments is what lets you keep
# the token out of your shell history: bin/generate takes positional arguments
# in a fixed order, so a custom path passed on the command line would otherwise
# force the token onto it too.

# Where the intermediate JSON definitions go. Commit these - they are the
# reviewable record of your Storyblok schema.
#STORYBLOK_DEFINITIONS_PATH=./src/dto-definitions

# Where the generated PHP classes go. Must contain nothing but generated
# classes - every *Transfer.php in here is deleted on each run.
#STORYBLOK_OUTPUT_PATH=./src/DataTransferObjects

# Namespace for the generated classes.
#STORYBLOK_NAMESPACE=App\DataTransferObjects

# Authorization header prefix. Empty for a personal access token (the default);
# set to Bearer for an OAuth-issued token.
#STORYBLOK_AUTH_SCHEME=

# Content Delivery API token - Storyblok > Settings > Access Tokens. A preview
# token reads drafts, a public token reads published content only. This is NOT
# the Management API token above: generation uses that one, reading content uses
# this one, and a project doing both needs both.
STORYBLOK_DELIVERY_TOKEN=

# Region endpoint for the Content Delivery API. Leave empty for the EU default;
# US, AP, CA and CN spaces each have their own host.
STORYBLOK_CONTENT_BASE_URI=

# Which version the content repositories read by default: published or draft.
# Set draft in preview environments.
STORYBLOK_DEFAULT_VERSION=


# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------

# off | coverage | debug | develop | trace
# Leave off for normal runs; Xdebug slows the suite down noticeably.
# `make test-coverage` sets coverage on its own, no need to change this.
XDEBUG_MODE=off

# Ownership of files the container writes into the mounted volume. The Makefile
# detects these from `id -u` / `id -g`, so you only need them when calling
# `docker compose` directly and the 1001 default is wrong for your user.
DOCKER_UID=1001
DOCKER_GID=1001
